# Routes site configuration.
# Copy to `.env` (or `.env.local`) and fill in real values before building.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NOTE: these are inlined into the static build — they are public, not secrets.

# WhatsApp group invite link (chat.whatsapp.com/... or a wa.me deep link)
VITE_WHATSAPP_GROUP_INVITE_LINK=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXX

# Driver onboarding phone, digits only in international format (used as tel:)
VITE_DRIVER_PHONE_NUMBER=2348000000000

# Support/contact phone, digits only in international format (used with wa.me)
VITE_SUPPORT_PHONE_NUMBER=2348000000000

# CAC registration (RC) number, shown in the footer, e.g. 1234567 (digits only, no "RC")
VITE_CAC_RC_NUMBER=1234567
